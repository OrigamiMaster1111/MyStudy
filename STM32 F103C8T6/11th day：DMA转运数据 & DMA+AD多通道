// const uint8_t aa = 0x66;
uint8_t DataA[] = {0x01, 0x02, 0x03, 0x04}; // 加 const 定义到FLASH内
uint8_t DataB[] = {0, 0, 0, 0};

int main(){

    OLED_Init();
    MyDMA_Init((uint32_t)DataA, (uint32_t)DataB, 4);

    OLED_ShowString(1, 1, "DataA");
    OLED_ShowString(3, 1, "DataB");
    OLED_ShowHexNum(1, 8, (uint32_t)DataA, 8);
    OLED_ShowHexNum(3, 8, (uint32_t)DataB, 8);

    Delay_ms(1000);

    MyDMA_Transfer();

    OLED_ShowHexNum(2, 1, DataA[0], 2);
    OLED_ShowHexNum(2, 4, DataA[1], 2);
    OLED_ShowHexNum(2, 7, DataA[2], 2);
    OLED_ShowHexNum(2, 10, DataA[3], 2);

    OLED_ShowHexNum(4, 1, DataB[0], 2);
    OLED_ShowHexNum(4, 4, DataB[1], 2);
    OLED_ShowHexNum(4, 7, DataB[2], 2);
    OLED_ShowHexNum(4, 10, DataB[3], 2);

    Delay_ms(1000);

    // OLED_ShowHexNum(1, 1, aa, 2);
    // OLED_ShowHexNum(2, 1, (uint32_t)&ADC1->DR, 8); // 访问ADC1的DR寄存器
    /*若想获得寄存器的地址，
     *首先查询此寄存器所在外设的起始地址，
     *随后在外设的寄存器总表中查询偏移。
     **/

    while (1){

        DataA[0]++;
        DataA[1]++;
        DataA[2]++;
        DataA[3]++;

        OLED_ShowHexNum(2, 1, DataA[0], 2);
        OLED_ShowHexNum(2, 4, DataA[1], 2);
        OLED_ShowHexNum(2, 7, DataA[2], 2);
        OLED_ShowHexNum(2, 10, DataA[3], 2);

        OLED_ShowHexNum(4, 1, DataB[0], 2);
        OLED_ShowHexNum(4, 4, DataB[1], 2);
        OLED_ShowHexNum(4, 7, DataB[2], 2);
        OLED_ShowHexNum(4, 10, DataB[3], 2);
    }
}


#include "stm32f10x.h"

uint16_t MyDMA_Size;

void MyDMA_Init(uint32_t AddrA, uint32_t AddrB, uint16_t Size){

    MyDMA_Size = Size;

    RCC_ABP2Periph_ClockCmd(RCC_AHBPeriph_DMA1, ENABLE);

    DMA_InitTypeDef DMA_InitStructure = {
        // 外设站点部分
        .DMA_PeripheralBaseAddr = AddrA,                        // 基地址
        .DMA_PeripheralDataSize = DMA_PeripheralDataSize_Byte,  // 数据宽度  以字节的方式传输
        .DMA_PeripheralInc = DMA_PeripheralInc_Enable,          // 是否自增
        // 存储器站点部分
        .DMA_MemoryBaseAddr = AddrB,                    // 基地址
        .DMA_MemoryDataSize = DMA_MemoryDataSize_Byte,  // 数据宽度 
        .DMA_MemoryInc = DMA_MemoryInc_Enable,          // 是否自增 
        
        .DMA_DIR = DMA_DIR_PeripheralSRC,  // 传输方向 外设到存储器
        .DMA_BufferSize = Size,            // 缓存区大小  此参数直接赋值给传输计数器的寄存器
        .DMA_Mode = DMA_Mode_Normal,           // 传输模式（是否使用自动重装 ps：软件触发不能使用自动重装）
        .DMA_M2M = DMA_M2M_Enable,            // 是否存储到存储器（硬件触发还是软件触发）
        .DMA_Priority = DMA_Priority_Medium,       // 优先级  指定通道的优先级
    };
    DMA_Init(DMA1_Channel1, &DMA_InitStructure);

    DMA_Cmd(DMA1_Channel1, DISABLE);
}

// 传输函数  调用一次就再次启动一次DMA转运
void MyDMA_Transfer(void){
    
    DMA_Cmd(DMA1_Channel1, DISABLE); // 传输计数器赋值前，必须使DMA失能
    DMA_SetCurrDataCounter(DMA1_Channel1, MyDMA_Size);
    DMA_Cmd(DMA1_Channel1, ENABLE);

    while (DMA_GetFlagStatus(DMA1_FLAG_TC1) == RESET); // 此处需要检查DMA1通道1转换完成的标志位
    DMA_ClearFlag(DMA1_FLAG_TC1);
}











